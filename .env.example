# Copy to .env in this folder (next to Dockerfile), fill in real values, then run: astro dev restart
# .env is gitignored. Never commit real values or paste them into DAGs, SUBMISSION.md or screenshots.
#
# Airflow exposes every AIRFLOW_VAR_<NAME> as an Airflow Variable, so DAGs read these with
# Variable.get("<NAME>"). Variables set this way do not appear in the UI under Admin -> Variables.

# Slack Incoming Webhook (bonus: failure alerts). Leave empty to print alerts to the task log instead.
AIRFLOW_VAR_SLACK_WEBHOOK_URL=

# Trainer's meridian_pipeline AI explainer (optional; it falls back to a plain message without these)
AIRFLOW_VAR_AZURE_OPENAI_API_KEY=
AIRFLOW_VAR_AZURE_OPENAI_ENDPOINT=
AIRFLOW_VAR_AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
